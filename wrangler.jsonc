{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "activa360",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "activa360-db",
      "database_id": "929c83aa-6839-434d-a335-aafe05465b80",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
"env": {
  "pilot": {
    "name": "activa360-pilot",
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "activa360-pilot-db",
        "database_id": "4e77b688-c0f9-4ef2-9c47-2e8a71ab0d10",
        "migrations_dir": "migrations"
      }
    ]
  }
}
}
